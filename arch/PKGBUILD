# Maintainer: CharOfString <root@charofstring.cc>
pkgbase=gxde-dock
pkgname=('gxde-dock' 'gxde-dock-onboard-plugin')
pkgver=6.0.44
pkgrel=1
pkgdesc='GXDE dock'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/gxde-dock"
license=('GPL-3.0-or-later')
_depends=('dtk2widget-qt6' 'gxde-dtk6core' 'gxde-dtk6gui' 'dframework-dbus-qt6' 'gxde-network-utils-qt6'
          'gsettings-qt6' 'layer-shell-qt' 'qt6-base' 'qt6-svg' 'wayland' 'libx11' 'libxcb'
          'xcb-util-image' 'xcb-util-wm' 'libxtst' 'libgcc' 'libstdc++' 'glibc')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools' "${_depends[@]}")
source=()
sha512sums=()

_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib
  ninja -C build
  DESTDIR="$srcdir/root" ninja -C build install
}

package_gxde-dock() {
  depends=("${_depends[@]}" 'gxde-deepin-menu' 'qt6-wayland' 'gxde-sni-server')
  optdepends=('gxde-dock-onboard-plugin: on-screen keyboard plugin')
  provides=('deepin-dock' "gxde-dock-git=$pkgver")
  conflicts=('deepin-dock' 'gxde-wlcom<2.2.0' 'gxde-dock-git')
  replaces=('gxde-dock-git')

  cp -r "$srcdir/root/." "$pkgdir/"
  rm "$pkgdir/usr/lib/gxde-dock/plugins/libonboard.so"
}

package_gxde-dock-onboard-plugin() {
  pkgdesc='GXDE dock on-screen keyboard plugin'
  depends=("gxde-dock=$pkgver-$pkgrel" 'onboard' 'dtk2widget-qt6' 'gxde-dtk6core' 'qt6-base'
           'libgcc' 'libstdc++' 'glibc')
  provides=("gxde-dock-onboard-plugin-git=$pkgver")
  conflicts=('gxde-dock-onboard-plugin-git')
  replaces=('gxde-dock-onboard-plugin-git')

  install -Dm755 "$srcdir/root/usr/lib/gxde-dock/plugins/libonboard.so" \
    "$pkgdir/usr/lib/gxde-dock/plugins/libonboard.so"
}
